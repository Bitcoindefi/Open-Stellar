# 🔐 LOCAL DEVELOPMENT ENVIRONMENT
# 
# ⚠️  SECURITY WARNING:
# - This file contains sensitive credentials
# - NEVER commit to git
# - Add to .gitignore (already done)
# - Delete after demo/development: rm .env.local
# - Use only Stellar TESTNET (never mainnet)
# 
# If secrets are leaked:
# 1. Immediately rotate keys
# 2. Audit git history: git log -p | grep ANTHROPIC_API_KEY
# 3. Check git doesn't have old commits: git log --all --oneline
# 4. Read SECURITY.md for full incident response

# Stellar Network - MUST BE 'testnet' for development
# ❌ NEVER use 'mainnet' locally - funds at risk!
STELLAR_NETWORK=testnet

# Development Mode - Disables auth, uses testnet
# Only set to 'true' if using testnet
DEV_MODE=true

# Admin API Key
# Full root access to /admin/* and administrative operations.
# In production, this variable is REQUIRED. In dev, auto-generated on first boot if unset.
ADMIN_API_KEY=osk_admin_your_secret_key_here

# Anthropic API Key
# Get from: https://console.anthropic.com/
# Format: sk-ant-...
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Moltbot Gateway Token
# Used for internal communication
# Can be any string for development
MOLTBOT_GATEWAY_TOKEN=dev-test-token-12345

# Optional: Cloudflare Access (if using CF auth)
# Leave empty for DEV_MODE=true
CF_ACCESS_CLIENT_ID=

# Optional: Enable debug routes (/debug/*)
DEBUG_ROUTES=false

# Optional: Stellar testnet public key that receives paid cosmetic purchases
# (e.g. the 0.5 XLM agent color-change fee). Leave empty to disable paid
# customization -- equip/unequip of already-unlocked cosmetics still works.
STELLAR_TREASURY_ADDRESS=

# Optional: Trusted proxy count for X-Forwarded-For parsing.
# Set to the number of reverse-proxy hops your infrastructure adds
# (e.g. "1" on Vercel, "2" if behind a load balancer + Cloudflare).
# When unset, the best-effort rightmost non-private IP is used instead.
# TRUSTED_PROXY_COUNT=1

# Optional: trust the cf-connecting-ip header for the client IP. Only set this
# when the app really runs behind Cloudflare; on Vercel clients can send it.
# TRUST_CF_CONNECTING_IP=true

# Optional: Force synchronous key-store flush on every authenticated request.
# Defaults to async/debounced (200ms). Set to "true" when accurate per-request
# usage counters matter (e.g. billing) at the cost of latency on hot paths.
# FLUSH_USAGE_SYNC=false

# ─────────────────────────────────────────────────────────────────────────────
# API KEY STORE BACKEND (required for serverless / multi-instance deployments)
# ─────────────────────────────────────────────────────────────────────────────
# By default, API keys are stored in .data/api-keys.json on the local
# filesystem — fine for self-hosted/local dev but NOT shared across serverless
# invocations (e.g. Vercel). Set the two vars below to enable Upstash Redis
# (or Vercel KV, which uses the same protocol) for a shared, durable store.
#
# Get these from https://console.upstash.com or Vercel dashboard → Storage → KV.
# UPSTASH_REDIS_REST_URL=https://us1-your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...your-token
#
# The same Redis also holds x402 payment -> agent bindings, one-review-per-payment
# claims and the 8004 registration quotas (lib/security/kv-store.ts). Without it
# those live in memory per instance, so set it in production. KV_REST_API_URL /
# KV_REST_API_TOKEN (Vercel KV integration names) are accepted as well.

# Optional: Better Stack / Logtail structured API logs
# Leave empty locally to keep logging as a no-op.
LOGTAIL_SOURCE_TOKEN=

# Optional: Custom EVM RPC URLs for x402 settlement
# Default BNB: https://bsc-dataseed.binance.org
# Default Base: https://mainnet.base.org
NEXT_PUBLIC_BNB_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=

# Optional: OpenAI Alternative (if using instead of Anthropic)
# OPENAI_API_KEY=sk-...

# Optional: Vercel AI Gateway / TypeSafe AI JEV
# BYOK is the default: each user should provide their own AI Gateway key
# per request. Do not put a personal key in a public/shared deployment.
# For a private single-user deployment only, set both vars below.
# AI_GATEWAY_API_KEY=
# OPEN_STELLAR_ALLOW_SERVER_AI_GATEWAY_KEY=true
OPEN_STELLAR_JEV_MODEL=typesafe-ai/jev
# Set this to typesafe-ai/jev if newly provisioned cloud agents should use JEV by default.
OPEN_STELLAR_DEFAULT_AGENT_MODEL=

# Optional local Laya decision sidecar (loopback only; see docs/LAYA_INTEGRATION.md)
OPEN_STELLAR_LAYA_URL=http://127.0.0.1:8788
LAYA_CHECKPOINT=convaiinnovations/laya
LAYA_LANG=es

# Optional: CosmosPay
# dv_ keys use Stellar testnet; prod_ keys use mainnet.
COSMOS_PAY_API_KEY=
COSMOS_PAY_WEBHOOK_SECRET=

# Optional: Telegram Bot Token
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional: Discord Bot Token
# DISCORD_BOT_TOKEN=...

# Optional: Slack Tokens
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# ════════════════════════════════════════════════════════════════════
# BEFORE RUNNING npm run dev:
# 
# 1. Make sure this file has restricted permissions:
#    chmod 600 .env.local
#
# 2. For maximum security, use Docker:
#    docker build -f Dockerfile.dev -t open-stellar-dev .
#    docker run --rm --env-file .env.local -p 5173:5173 open-stellar-dev
#
# 3. Before demo, audit for leaks:
#    ./scripts/security-audit.sh
#
# 4. After demo, delete this file:
#    rm .env.local
# ════════════════════════════════════════════════════════════════════

# --- Sign in with Google and login-based connections -------------------------
# Secret used to encrypt session and connection cookies (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Public URL of this deployment, e.g. https://agentic-city.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth web client. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- x402 on Solana devnet (paid agent tasks) ---------------------------------
# Treasury address that receives USDC. It needs a devnet USDC token account.
X402_SOLANA_PAY_TO=
# Facilitator (verifies and settles, pays the network fee). Default: https://x402.org/facilitator
X402_FACILITATOR_URL=
# Optional dedicated devnet RPC for the browser (public one is rate limited)
NEXT_PUBLIC_SOLANA_RPC=
# Server keypair (JSON array of 64 numbers) that owns agent identities in the 8004 registry and
# pays registration and review fees on devnet. Never commit it.
SOLANA_SERVER_SECRET=
# Optional devnet RPC for server-side Solana calls
SOLANA_RPC=

# --- Paid agent-to-agent hires (per-browser agents' wallet, Solana devnet) ------
# No platform wallet: each browser gets its own agents' wallet on first use. Its key lives only
# in a sealed httpOnly cookie (ac_agent_wallet, encrypted with BETTER_AUTH_SECRET or
# CONNECTIONS_SECRET); the person funds it from Phantom/Solflare and it pays 0.01 USDC per hire.
# SOLANA_SERVER_SECRET (above) sponsors the funding transaction (fee + one-time USDC account
# rent, returned on withdraw) and pays withdrawal fees, so nobody needs SOL. Without it the
# person's wallet pays the funding fee and withdrawals are off. Optional cookie key rotation:
# put the old secret here while CONNECTIONS_SECRET holds the new one.
CONNECTIONS_SECRET_PREVIOUS=
# Spending caps in USDC, per browser. Above them a hire waits for the person's approval in the chat.
ORCHESTRATOR_MAX_USDC_PER_RUN=0.03
ORCHESTRATOR_MAX_USDC_PER_DAY=0.5
# Ceiling that even approved hires cannot pass (per browser and UTC day).
ORCHESTRATOR_HARD_MAX_USDC_PER_DAY=2
# Optional: HMAC secret for approval tokens (default: derived from the cookie-sealing secret)
ORCHESTRATOR_APPROVAL_SECRET=
# Optional: where hired agents' x402 endpoints live (default: this deployment's origin)
ORCHESTRATOR_X402_BASE_URL=
# Optional: devnet RPC the server uses for agents' wallets (payments, balances, withdrawals)
SOLANA_DEVNET_RPC_URL=
# Upstash Redis (or Vercel KV) keeps the daily ledger and single-use approvals across instances:
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (see the API key store section above)

# --- Remote MCP server (/api/mcp) ---------------------------------------------------
# MCP clients (Claude Code, Cursor, Claude Desktop) connect with OAuth: the person approves in
# the browser. Tokens and the encrypted grant wallets live in the Redis store above (required in
# production). Agents hired over MCP answer with this hosted model; without a key, hiring is off.
# MCP_AGENT_PROVIDER=vercel-ai-gateway
# MCP_AGENT_MODEL=openai/gpt-4o-mini
# MCP_AGENT_API_KEY=            # defaults to AI_GATEWAY_API_KEY for the gateway
# Default daily cap per connected client (never above ORCHESTRATOR_MAX_USDC_PER_DAY)
# MCP_GRANT_MAX_USDC_PER_DAY=0.1
# Optional: pin the public origin used in OAuth metadata (when a proxy rewrites the host)
# MCP_PUBLIC_ORIGIN=https://agentic-city.vercel.app

# --- Legacy Stellar UI ------------------------------------------------------------
# The public UI is Solana-first. Set to true to show the old Stellar surfaces again
# (Freighter wallet panel, XLM labels, Soroban attestations, paid agent color).
# Build-time flag: redeploy after changing it. /api/stellar/* routes work either way.
NEXT_PUBLIC_ENABLE_STELLAR=false
